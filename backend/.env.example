# Copy this file to .env and fill in your key

# Free API key from https://console.groq.com/keys -- used for summarization
GROQ_API_KEY=gsk_...

# Groq model used for summary + action item generation.
SUMMARY_MODEL=llama-3.3-70b-versatile

# Local Whisper model size for transcription (no key needed, runs on your machine).
# Options: tiny, base, small, medium, large -- bigger = more accurate, slower.
WHISPER_MODEL_SIZE=base

# SQLite file location
DATABASE_URL=sqlite:///./meetings.db
